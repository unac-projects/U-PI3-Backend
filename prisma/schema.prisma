generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tus enumerados y modelos (Usuario, Rol, etc.)
enum Rol {
  ESTUDIANTE
  PROFESIONAL_CAU
  ENCARGADO_CAU
  ADMIN
}

enum EstadoUsuario {
  ACTIVO
  SANCIONADO
}

model Usuario {
  id        Int           @id @default(autoincrement())
  nombre    String
  correo    String        @unique
  googleId  String?       @map("google_id")
  rol       Rol           @default(ESTUDIANTE)
  estado    EstadoUsuario @default(ACTIVO)
  creadoEn  DateTime      @default(now()) @map("creado_en")

  // Campo de relación (no agrega columna en la tabla 'usuarios')
  prestamos Prestamo[]

  reservas  Reserva[]

  @@map("usuarios")
}

// ---------------------- Cambios Daniel

// Estados del préstamo
enum EstadoPrestamo {
  SOLICITADO
  EN_PRESTAMO
  DEVUELTO
  CANCELADO
}

// Modelo del Implemento Deportivo (RF-09)
model Implemento {
  id              Int        @id @default(autoincrement())
  nombre          String
  descripcion     String?
  stockTotal      Int        @map("stock_total")
  stockDisponible Int        @map("stock_disponible")
  categoria       String?
  creadoEn        DateTime   @default(now()) @map("creado_en")
  prestamos       Prestamo[]

  @@map("implementos")
}

// Modelo del Préstamo (RF-10, RF-11, RF-12)
model Prestamo {
  id               Int            @id @default(autoincrement())
  usuarioId        Int            @map("usuario_id")
  implementoId     Int            @map("implemento_id")
  tokenQr          String         @unique @map("token_qr")
  estado           EstadoPrestamo @default(SOLICITADO)
  fechaSolicitud   DateTime       @default(now()) @map("fecha_solicitud")
  fechaEntrega     DateTime?      @map("fecha_entrega")
  fechaDevolucion  DateTime?      @map("fecha_devolucion")
  fechaLimite      DateTime?      @map("fecha_limite")

  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  implemento Implemento @relation(fields: [implementoId], references: [id])

  @@map("prestamos")
}


// ---------------------- Cambios Duvan

// Corregido: "enum" en minúscula y el nombre EstadoReserva
enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  FINALIZADA
}

// Modelo para los Espacios Deportivos (Canchas, Sintética, Múltiple, etc.)
model EspacioDeportivo {
  id               String    @id @default(uuid())
  nombre           String
  minParticipantes Int       @default(1) @map("min_participantes")
  creadoEn         DateTime  @default(now()) @map("creado_en")
  reservas         Reserva[]

  @@map("espacios_deportivos")
}

// Modelo para las Reservas realizadas por los estudiantes
model Reserva {
  id               String        @id @default(uuid())
  usuarioId        Int           @map("usuario_id")
  espacioId        String        @map("espacio_id")
  fechaInicio      DateTime      @map("fecha_inicio")
  fechaFin         DateTime      @map("fecha_fin")
  cantidadPersonas Int           @map("cantidad_personas")
  estado           EstadoReserva @default(CONFIRMADA)
  creadoEn         DateTime      @default(now()) @map("creado_en")

  usuario Usuario          @relation(fields: [usuarioId], references: [id])
  espacio EspacioDeportivo @relation(fields: [espacioId], references: [id])

  @@map("reservas")
}