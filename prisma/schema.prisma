generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// CONFIGURACIÓN GENERAL Y USUARIOS
// ==========================================

enum Rol {
  ESTUDIANTE
  PROFESIONAL_CAU
  ENCARGADO_CAU
  ADMINISTRATIVO
  ADMIN
}

enum EstadoUsuario {
  ACTIVO
  SANCIONADO
}

model Usuario {
  id             Int           @id @default(autoincrement())
  nombreCompleto String?       @map("nombre_completo")
  nombre         String?
  correo         String        @unique
  documento      String?       @unique
  googleId       String?       @map("google_id")
  rol            Rol           @default(ESTUDIANTE)
  estado         EstadoUsuario @default(ACTIVO)
  creadoEn       DateTime      @default(now()) @map("creado_en")

  // Relaciones Módulo 3: Préstamos (Daniel)
  prestamos Prestamo[]

  // Relaciones Módulo 1: Reservas de Espacios (Duván)
  reservas Reserva[]

  // Relaciones Módulo 2: Agendamiento de Citas (Gabriel)
  citasEstudiante  Cita[]                      @relation("EstudianteCitas")
  citasProfesional Cita[]                      @relation("ProfesionalCitas")
  disponibilidades DisponibilidadProfesional[]

  @@map("usuarios")
}

// ==========================================
// MÓDULO 3: PRÉSTAMO DE IMPLEMENTOS DEPORTIVOS
// ==========================================

enum EstadoPrestamo {
  SOLICITADO
  EN_PRESTAMO
  DEVUELTO
  CANCELADO
}

model Implemento {
  id              Int        @id @default(autoincrement())
  nombre          String
  descripcion     String?
  stockTotal      Int        @map("stock_total")
  stockDisponible Int        @map("stock_disponible")
  categoria       String?
  creadoEn        DateTime   @default(now()) @map("creado_en")
  prestamos       Prestamo[]

  @@map("implementos")
}

model Prestamo {
  id              Int            @id @default(autoincrement())
  usuarioId       Int            @map("usuario_id")
  implementoId    Int            @map("implemento_id")
  tokenQr         String         @unique @map("token_qr")
  estado          EstadoPrestamo @default(SOLICITADO)
  fechaSolicitud  DateTime       @default(now()) @map("fecha_solicitud")
  fechaEntrega    DateTime?      @map("fecha_entrega")
  fechaDevolucion DateTime?      @map("fecha_devolucion")
  fechaLimite     DateTime?      @map("fecha_limite")

  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  implemento Implemento @relation(fields: [implementoId], references: [id])

  @@map("prestamos")
}

// ==========================================
// MÓDULO 1: RESERVA DE ESPACIOS DEPORTIVOS
// ==========================================

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  FINALIZADA
}

model EspacioDeportivo {
  id               String    @id @default(uuid())
  nombre           String
  minParticipantes Int       @default(1) @map("min_participantes")
  creadoEn         DateTime  @default(now()) @map("creado_en")
  reservas         Reserva[]

  @@map("espacios_deportivos")
}

model Reserva {
  id               String        @id @default(uuid())
  usuarioId        Int           @map("usuario_id")
  espacioId        String        @map("espacio_id")
  fechaInicio      DateTime      @map("fecha_inicio")
  fechaFin         DateTime      @map("fecha_fin")
  cantidadPersonas Int           @map("cantidad_personas")
  estado           EstadoReserva @default(CONFIRMADA)
  creadoEn         DateTime      @default(now()) @map("creado_en")

  usuario Usuario          @relation(fields: [usuarioId], references: [id])
  espacio EspacioDeportivo @relation(fields: [espacioId], references: [id])

  @@map("reservas")
}

// ==========================================
// MÓDULO 2: AGENDAMIENTO DE CITAS DE ATENCIÓN
// ==========================================

enum CategoriaServicio {
  PSICOLOGIA
  NUTRITION
  ESPIRITUAL
}

enum EstadoCita {
  PROGRAMADA
  ATENDIDA
  CANCELADA
}

enum EstadoDisponibilidad {
  DISPONIBLE
  BLOQUEADO
}

model DisponibilidadProfesional {
  id            Int                  @id @default(autoincrement())
  profesionalId Int                  @map("profesional_id")
  profesional   Usuario              @relation(fields: [profesionalId], references: [id])
  fecha         DateTime
  horaInicio    String               @map("hora_inicio")
  horaFin       String               @map("hora_fin")
  estado        EstadoDisponibilidad @default(DISPONIBLE)

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("disponibilidades_profesionales")
}

model Cita {
  id            Int               @id @default(autoincrement())
  estudianteId  Int               @map("estudiante_id")
  estudiante    Usuario           @relation("EstudianteCitas", fields: [estudianteId], references: [id])
  profesionalId Int               @map("profesional_id")
  profesional   Usuario           @relation("ProfesionalCitas", fields: [profesionalId], references: [id])
  servicio      CategoriaServicio
  fechaHora     DateTime          @map("fecha_hora")
  motivo        String?
  estado        EstadoCita        @default(PROGRAMADA)

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("citas")
}